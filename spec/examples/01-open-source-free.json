  },
  "capabilities": ["theming", "theming.pack"],
  "settings": [
    { "key": "mode", "type": "select", "label": "主题模式", "default": "auto", "options": [{ "value": "light", "label": "浅色" }, { "value": "dark", "label": "深色" }, { "value": "auto", "label": "跟随系统" }] },
    { "key": "sheen", "type": "int", "label": "光泽强度", "default": 50, "min": 0, "max": 100, "step": 5, "unit": "%" },
    { "key": "wallpaper", "type": "select", "label": "壁纸", "default": "aurora", "options": [{ "value": "aurora", "label": "极光" }, { "value": "dawn", "label": "黎明" }, { "value": "night", "label": "深夜" }] }
