      "format": "moxp",
      "compression": "zstd"
    },
    "mirrors": ["https://ghproxy.net/https://cdn.moxsh.app/plugins/theme-aurora-1.3.2.moxp"],
    "registry": { "name": "moxsh-official", "url": "https://registry.moxsh.app" },
    "autoUpdate": true
  },
  "entrypoints": {
    "registrar": "com.moxsh.plugin.theme.aurora.AuroraRegistrar",
    "screen": "com.moxsh.plugin.theme.aurora.AuroraScreen",
