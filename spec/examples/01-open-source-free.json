{
  "schemaVersion": "1.0",
  "id": "com.moxsh.plugin.theme.aurora",
  "name": "极光玻璃主题",
  "nameI18n": { "en": "Aurora Glass Theme", "zh-Hant": "極光玻璃主題" },
  "version": "1.3.2",
  "author": { "name": "MoX Studio", "url": "https://moxsh.app", "moxId": "mox_aurora", "avatar": "https://cdn.moxsh.app/authors/aurora.png" },
  "publisher": { "id": "moxstudio", "name": "MoX Studio", "url": "https://moxsh.app", "verified": true },
  "description": "一套极光青配色的液态玻璃主题，含深浅双色、动态光泽与折射。",
  "descriptionI18n": { "en": "An aurora-cyan liquid-glass theme with light/dark variants and dynamic sheen." },
  "longDescription": "## 极光玻璃主题\n\n- 全方位液态玻璃：多边缘镜面倒角高光 + 135° 斜向光泽\n- 深浅双模式，跟随系统自动切换\n- 三套壁纸渐变，CPU 友好\n\n> 学习自 iOS 27 Liquid Glass 语言，克制而不寡淡。",
  "icon": "assets/icon.png",
  "banner": "assets/banner.png",
  "screenshots": ["assets/s1.png", "assets/s2.png", "assets/s3.png"],
  "categories": ["theming"],
  "tags": ["glass", "theme", "liquid", "ios27"],
  "keywords": ["主题", "玻璃", "极光", "liquid glass", "theme"],
  "homepage": "https://moxsh.app/plugins/aurora",
  "repository": { "type": "git", "url": "https://github.com/moxsh-dev/theme-aurora" },
  "issues": "https://github.com/moxsh-dev/theme-aurora/issues",
  "license": { "spdx": "MIT", "name": "MIT License", "url": "https://opensource.org/licenses/MIT", "file": "LICENSE" },
  "visibility": "open-source",
  "sourceCode": { "url": "https://github.com/moxsh-dev/theme-aurora", "license": "MIT", "buildDocs": "https://moxsh.app/docs/build-plugin" },
  "pricing": { "model": "free", "note": "完全免费。喜欢的话欢迎到爱发电请作者喝杯咖啡。" },
