  "permissions": [
    { "name": "container", "reason": "需要与容器运行时交互来起停、查看容器" },
    { "name": "exec", "reason": "进入容器终端需要执行 shell 命令" },
    { "name": "storage.read", "reason": "读取本地镜像缓存与配置文件" },
    { "name": "network", "reason": "拉取镜像与检查更新" }
  ],
  "dependencies": {
    "plugins": [{ "id": "com.moxsh.plugin.core", "version": ">=1.0.0" }],
    "native": [{ "name": "docker-cli", "abi": "arm64-v8a", "version": ">=24.0" }]
  },
  "capabilities": ["container.docker", "terminal.ui"],
  "settings": [
    { "key": "defaultRegistry", "type": "string", "label": "默认镜像源", "default": "registry.cn-hangzhou.aliyuncs.com" },
    { "key": "pollInterval", "type": "int", "label": "状态轮询间隔", "default": 3, "min": 1, "max": 30, "unit": "秒", "advanced": true }
