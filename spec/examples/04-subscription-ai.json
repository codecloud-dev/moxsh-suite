    "abis": ["universal"],
    "supportedOs": ["android"]
  },
  "distribution": {
    "type": "registry",
    "channel": "stable",
    "artifact": {
      "url": "https://cdn.moxsh.app/plugins/ai-pro-3.1.0.moxp",
      "size": 2145800,
      "sha256": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
      "format": "moxp",
      "compression": "zstd"
    },
    "registry": { "name": "moxsh-official", "url": "https://registry.moxsh.app" },
    "autoUpdate": true
  },
  "entrypoints": {
    "registrar": "app.moxsh.ai.pro.AiProRegistrar",
