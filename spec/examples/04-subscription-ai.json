      { "id": "yearly", "name": "Pro 年付", "description": "相当于 ¥10/月", "price": 118, "compareAtPrice": 144, "billing": "yearly", "recommended": true, "features": ["全技能库", "Agent 工具", "长上下文", "多设备同步"], "quota": { "devices": 5 } },
      { "id": "lifetime", "name": "终身版", "price": 399, "billing": "lifetime", "features": ["一次性买断", "含 2 年新功能", "优先接入新模型"], "quota": { "devices": 3 } }
    ],
    "provider": {
      "type": "afdian",
      "afdian": {
        "creatorPage": "https://afdian.com/a/moxlabs",
        "shopItems": [
          { "planId": "monthly", "itemId": "aa11bb22cc", "skuId": "ai-pro-month" },
