  "permissions": [
    { "name": "network", "reason": "调用你配置的 AI 模型接口需要联网" },
    { "name": "storage.read", "reason": "读取你让它分析的文件内容", "optional": true },
    { "name": "storage.write", "reason": "把 AI 生成的脚本/文件保存到本地", "optional": true },
    { "name": "exec", "reason": "Agent 工具执行终端命令（每次都会先征得你同意）", "optional": true }
  ],
  "dependencies": {
    "plugins": [{ "id": "com.moxsh.plugin.core", "version": ">=1.0.0" }]
  },
  "capabilities": ["ai.provider", "ai.skill", "ai.tool"],
  "settings": [
    { "key": "defaultProvider", "type": "select", "label": "默认模型", "default": "zhipu", "options": [{ "value": "deepseek", "label": "DeepSeek" }, { "value": "zhipu", "label": "智谱 GLM" }, { "value": "qwen", "label": "通义千问" }, { "value": "moonshot", "label": "Kimi" }, { "value": "local", "label": "本地模型" }] },
    { "key": "apiKey", "type": "password", "label": "API Key", "description": "经 AndroidKeyStore AES-GCM 加密存储，不上传。" },
    { "key": "temperature", "type": "float", "label": "温度", "default": 0.7, "min": 0, "max": 2, "step": 0.1, "advanced": true },
    { "key": "dangerousTools", "type": "bool", "label": "允许危险工具（需二次确认）", "default": false, "advanced": true, "restartRequired": false }
  ],
  "i18n": { "defaultLocale": "zh-Hans", "locales": ["zh-Hans", "en"], "path": "locales/" },
